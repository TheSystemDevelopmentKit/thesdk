#fi

## Firs we run linter
#  $LINTER $STAGED_FILES
#  if [ "$?" != "0" ]; then
#    echo "ERROR: Some Python files are not structured properly. Please run:"
#    echo "To check:"
#    echo "    $LINTER ${STAGED_FILES}"
#    echo "Correct with care. Autofixes does not fix everything properly."
#    exit 1
#  fi
#fi

# Run black in check mode (it won't modify files, just checks for formatting issues)
if [ ! -z ${STAGED_FILES} ]; then
    $FORMATTER $STAGED_FILES

# If black returns a non-zero exit code (i.e., files aren't formatted correctly), exit with an error
    if [ "$?" != "0" ]; then
      echo "ERROR: Some Python files are not formatted correctly. Please run:"
      echo "To check:"
      echo "    $CHECKER ${STAGED_FILES}"
      echo "To correct:"
      echo "     $FORMATTER ${STAGED_FILES}"
      exit 1
    fi
fi

exit 0

