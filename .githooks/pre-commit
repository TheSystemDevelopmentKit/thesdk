#!/usr/bin/env bash
# Get a list of all Python files that are staged for commit

#Line length from PEP8 standard
LL="79"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | xargs)
FORMATTER="black -l $LL"
CHECKER="black -l $LL --check --diff --color"
LINTER="pylint"

# If there are Python files staged for commit, run linter on them
#if [ -n "$STAGED_FILES" ]; then
